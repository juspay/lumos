# LiteLLM proxy (AI provider)
LITELLM_BASE_URL=https://grid.ai.juspay.net
LITELLM_API_KEY=sk-your-litellm-api-key

# Bitbucket DC (MCP server)
BITBUCKET_BASE_URL=https://bitbucket.juspay.net
BITBUCKET_USERNAME=your.username
BITBUCKET_TOKEN=your-bitbucket-http-access-token

# Jira Cloud (optional, for Jira MCP)
JIRA_API_TOKEN=your-jira-api-token
JIRA_EMAIL=your.email@juspay.in
JIRA_BASE_URL=https://juspay.atlassian.net

# Langfuse observability (optional)
# Setting LANGFUSE_PUBLIC_KEY automatically enables Langfuse tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Config overrides (optional, highest precedence)
# LUMOS_PROVIDER=vertex
# LUMOS_MODEL=claude-sonnet-4-5@20250929
# LUMOS_TIMEOUT=5m
# LUMOS_MAX_TOKENS=30000
# LUMOS_MAX_TOKEN_BUDGET=500000
# LUMOS_MAX_COST=2.0
