## 💻 LUMOS DEVELOPMENT STANDARDS

### **TypeScript Architecture**
```typescript
// Strict type safety for AI responses
interface LumosAnalysis {
  summary: string;
  confidence: number;
  error_type: ErrorType;
  root_cause: string;
  suggestions: FixSuggestion[];
  research_findings: ResearchResult[];
  visual_evidence?: VisualEvidence;
  pattern_matches: PatternMatch[];
}

// Multi-provider AI coordination with Neurolink
class NeuroLinkCoordinator {
  async analyzeError(error: string, context?: string): Promise<ConsensusResult> {
    // Coordinate multiple AI providers for consensus-based analysis
    const providers = ['openai', 'anthropic', 'google'];
    const results = await Promise.all(
      providers.map(provider => this.neurolink.query(provider, prompt))
    );
    return this.buildConsensus(results);
  }
}

// Pattern recognition with machine learning
class PatternEngine {
  async recognizePattern(error: string): Promise<PatternMatch[]> {
    // SQLite-based pattern matching with confidence scoring
  }
}
```

### **Error Analysis Patterns**
```typescript
// Comprehensive error categorization
const ERROR_PATTERNS = {
  REFERENCE_ERROR: {
    regex: /ReferenceError: .* is not defined/,
    category: 'LOGIC_ERROR',
    confidence: 0.95,
    common_fixes: ['check_imports', 'verify_scope', 'check_spelling']
  },
  TYPE_ERROR: {
    regex: /TypeError: Cannot read propert.* of (null|undefined)/,
    category: 'NULL_REFERENCE',
    confidence: 0.92,
    common_fixes: ['null_check', 'optional_chaining', 'default_value']
  },
  DOM_ERROR: {
    regex: /Element .* not found|Cannot read.*addEventListener/,
    category: 'UI_INTERACTION',
    confidence: 0.88,
    common_fixes: ['wait_for_element', 'check_selector', 'dom_ready']
  },
  NETWORK_ERROR: {
    regex: /(CORS|fetch.*failed|ERR_NETWORK|timeout)/i,
    category: 'NETWORK_ISSUE',
    confidence: 0.90,
    common_fixes: ['cors_config', 'retry_logic', 'timeout_increase']
  }
};
```

### **Code Quality Standards**
```typescript
// ESLint configuration for enterprise quality
module.exports = {
  extends: ['@typescript-eslint/recommended'],
  rules: {
    '@typescript-eslint/no-explicit-any': 'error',
    '@typescript-eslint/strict-boolean-expressions': 'error',
    'prefer-const': 'error',
    'no-var': 'error'
  }
};

// Prettier configuration for consistent formatting
module.exports = {
  semi: true,
  singleQuote: true,
  tabWidth: 2,
  trailingComma: 'es5'
};
```

